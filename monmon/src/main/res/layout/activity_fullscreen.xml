<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/black">

    <!-- UVC 预览（非峰焦模式直通显示） -->
    <com.serenegiant.widget.AspectRatioSurfaceView
        android:id="@+id/svCameraViewMain"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone" />

    <!-- 峰焦模式处理帧显示 -->
    <ImageView
        android:id="@+id/svCameraOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:contentDescription="preview"
        android:scaleType="fitCenter"
        android:visibility="gone" />

    <!-- 加载状态 -->
    <TextView
        android:id="@+id/tvStatus"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:textColor="@color/text_secondary"
        android:textSize="14sp"
        android:visibility="gone" />

    <!-- 顶部控制条 -->
    <LinearLayout
        android:id="@+id/topBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@drawable/bg_scrim_top"
        android:paddingStart="6dp"
        android:paddingEnd="12dp"
        android:paddingTop="4dp"
        android:paddingBottom="10dp"
        android:visibility="gone">

        <ImageButton
            android:id="@+id/btnBack"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:src="@drawable/ic_back"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/back"
            app:tint="@color/text_primary" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center_vertical"
            android:paddingStart="4dp">

            <TextView
                android:id="@+id/tvTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/app_name"
                android:textColor="@color/text_primary"
                android:textSize="16sp"
                android:textStyle="bold"
                android:maxLines="1"
                android:ellipsize="end" />

            <TextView
                android:id="@+id/tvResolution"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/text_secondary"
                android:textSize="12sp"
                android:layout_marginTop="1dp" />
        </LinearLayout>

        <ImageButton
            android:id="@+id/btnSettings"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:src="@drawable/ic_settings"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/peak_focus"
            app:tint="@color/text_primary" />
    </LinearLayout>

    <!-- 底部控制条 -->
    <LinearLayout
        android:id="@+id/bottomBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:orientation="horizontal"
        android:gravity="center"
        android:background="@drawable/bg_scrim_bottom"
        android:paddingStart="24dp"
        android:paddingEnd="24dp"
        android:paddingTop="12dp"
        android:paddingBottom="12dp"
        android:visibility="gone">

        <ImageButton
            android:id="@+id/btnRotate"
            android:layout_width="52dp"
            android:layout_height="52dp"
            android:src="@drawable/ic_rotate"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/rotate"
            app:tint="@color/text_primary" />

        <ImageButton
            android:id="@+id/btnPeak"
            android:layout_width="52dp"
            android:layout_height="52dp"
            android:layout_marginStart="24dp"
            android:layout_marginEnd="24dp"
            android:src="@drawable/ic_peak"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/peak_focus"
            app:tint="@color/secondary" />

        <ImageButton
            android:id="@+id/btnResolution"
            android:layout_width="52dp"
            android:layout_height="52dp"
            android:src="@drawable/ic_resolution"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/resolution"
            app:tint="@color/text_primary" />
    </LinearLayout>
</FrameLayout>
